# Server settings. Copy to /etc/lianshiji.env (systemd EnvironmentFile, mode 600, owned by root) or to .env (docker compose).
# One KEY=value per line: no quotes, no spaces, no comments after a value (systemd would keep them as part of the value).
# Make secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Claude's CLI token. It reads and writes EVERY account's data (it cannot manage accounts).
# The same value goes into ~/.config/lianshiji/config.json on the computer that runs Claude Code.
LSJ_TOKEN=change-me

# The first admin, created only while the database has no accounts at all; ignored afterwards.
LSJ_ADMIN_USER=admin
LSJ_PASSWORD=change-me

# Data directory (data.db and photos/), listen address and port. Keep the address on 127.0.0.1 behind a reverse proxy.
LSJ_DATA=/var/lib/lianshiji
LSJ_HOST=127.0.0.1
LSJ_PORT=8780

# Time zone for dates and sleep times, and the hour a new day starts: with 5, anything logged before 05:00
# counts for the day before (for people who go to bed after midnight). 0 = midnight.
LSJ_TZ=Asia/Shanghai
LSJ_DAY_START_HOUR=5

# 1: the session cookie is sent over HTTPS only. Set 0 only to try the server over plain http on your own machine.
LSJ_COOKIE_SECURE=1

# Push notifications: the contact push services see in each request (VAPID "sub"), a mailto: or https: address.
# The signing keys are made on first use in LSJ_DATA/vapid.json; keep that file with your backups.
LSJ_PUSH_CONTACT=mailto:noreply@lianshiji.invalid
# Address invite links use (https://your-domain). Unset: the Host of the admin's request.
# LSJ_PUBLIC_URL=https://fitness.example.com

# docker compose only (deploy/compose.example.yaml): the domain Caddy gets a certificate for.
LSJ_DOMAIN=fitness.example.com
