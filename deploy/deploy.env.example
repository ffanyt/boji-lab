# Copy to deploy/.deploy.env (gitignored) and fill in. Read by deploy/deploy.sh and deploy/make-shortcut.py;
# variables already set in the environment win over this file.
# ssh target that can write the install dir and restart the service
LSJ_DEPLOY_HOST=root@fitness.example.com
# ssh private key (optional: leave empty to let ssh pick, e.g. from ~/.ssh/config)
LSJ_DEPLOY_KEY=~/.ssh/id_ed25519
# where server.py and web/ go on the server, and the systemd unit to restart
LSJ_DEPLOY_DIR=/opt/lianshiji
LSJ_DEPLOY_SERVICE=lianshiji
# public https address of the site; make-shortcut.py bakes it into the Shortcut
LSJ_URL=https://fitness.example.com
